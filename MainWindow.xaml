<Window x:Class="YoloDatasetStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="YOLO Dataset Studio" Width="1400" Height="850" MinWidth="1000" MinHeight="650" KeyDown="Window_KeyDown">
<Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel Grid.Row="0"><Button Content="Создать датасет" Click="CreateDataset_Click"/><Button Content="Открыть датасет" Click="OpenDataset_Click"/><Button Content="Добавить фото" Click="AddImages_Click"/><Button Content="Добавить папку" Click="AddFolder_Click"/><Button Content="Удалить фото" Click="DeleteImage_Click"/><Button Content="Удалить без разметки" Click="DeleteUnlabeled_Click"/><Button Content="Сохранить" Click="Save_Click"/><Button Content="Train/Val/Test" Click="Split_Click"/></WrapPanel>
<WrapPanel Grid.Row="1" Margin="0,8"><TextBlock Text="Модель YOLOv8:" VerticalAlignment="Center"/><ComboBox x:Name="ModelBox" Width="180" Margin="8,0" SelectedIndex="0"><ComboBoxItem>yolov8n.pt</ComboBoxItem><ComboBoxItem>yolov8s.pt</ComboBoxItem><ComboBoxItem>yolov8m.pt</ComboBoxItem><ComboBoxItem>yolov8l.pt</ComboBoxItem><ComboBoxItem>yolov8x.pt</ComboBoxItem><ComboBoxItem>yolov8n-seg.pt</ComboBoxItem><ComboBoxItem>yolov8s-seg.pt</ComboBoxItem><ComboBoxItem>yolov8m-seg.pt</ComboBoxItem></ComboBox><Button Content="Выбрать .pt" Click="ChooseModel_Click"/><TextBlock x:Name="ModelInfo" Text="yolov8n.pt" Width="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="Порог уверенности:" VerticalAlignment="Center"/><Slider x:Name="ConfidenceSlider" Width="130" Minimum="1" Maximum="99" Value="25" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ConfidenceSlider_ValueChanged"/><TextBlock x:Name="ConfidenceInfo" Text="25%" Width="45" VerticalAlignment="Center"/><TextBlock Text="Устройство:" VerticalAlignment="Center"/><ComboBox x:Name="DeviceBox" Width="105" Margin="5,0" SelectedIndex="0"><ComboBoxItem>CPU</ComboBoxItem><ComboBoxItem>GPU</ComboBoxItem><ComboBoxItem>Auto</ComboBoxItem></ComboBox><TextBlock Text="Эпохи:" VerticalAlignment="Center"/><TextBox x:Name="EpochsBox" Text="50" Width="55" Margin="4,0"/><TextBlock Text="Режим:" VerticalAlignment="Center"/><ComboBox x:Name="ModeBox" Width="120" Margin="8,0" SelectedIndex="0"><ComboBoxItem>detect</ComboBoxItem><ComboBoxItem>segment</ComboBoxItem></ComboBox><Button Content="Авторазметка" Click="Annotate_Click"/><Button Content="Обучить / дообучить" Click="Train_Click"/><Button Content="Остановить" Click="StopOperation_Click"/><Button Content="Выбрать лучшую модель" Click="ChooseTrainedModel_Click"/></WrapPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
<ListBox x:Name="ImagesList" Grid.Column="0" SelectionChanged="ImagesList_SelectionChanged" DisplayMemberPath="Name"/>
<Grid Grid.Column="1" Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border BorderBrush="Gray" BorderThickness="1" Background="#202020"><Grid><Image x:Name="Preview" Stretch="Uniform"/><Canvas x:Name="Overlay" Background="Transparent" MouseMove="Overlay_MouseMove" MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseRightButtonDown="Overlay_MouseRightButtonDown" SizeChanged="Overlay_SizeChanged"/></Grid></Border><WrapPanel Grid.Row="1" HorizontalAlignment="Center"><Button Content="◀ Назад" Click="Previous_Click"/><Button Content="Вперёд ▶" Click="Next_Click"/></WrapPanel><TextBlock Grid.Row="2" x:Name="ImageInfo" Foreground="Gray" Margin="0,5"/></Grid>
<Grid Grid.Column="2" Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Разметка (YOLO bbox)" FontWeight="Bold"/><DataGrid x:Name="AnnotationsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="Класс" Binding="{Binding ClassIndex, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="X" Binding="{Binding CenterX, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Y" Binding="{Binding CenterY, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="W" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="H" Binding="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2"><Button Content="Удалить объект" Click="DeleteAnnotation_Click"/><Button Content="Применить разметку" Click="ApplyAnnotations_Click"/><Button Content="Отмена" Click="Undo_Click"/></WrapPanel></Grid></Grid>
<StatusBar Grid.Row="3"><StatusBarItem x:Name="Status" Content="Создайте или откройте датасет"/><ProgressBar x:Name="OperationProgress" Width="180" Height="16" Minimum="0" Maximum="100" Margin="12,0"/><StatusBarItem x:Name="Details" Content="Готово"/></StatusBar>
</Grid></Window>
